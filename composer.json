{
    "name": "leventust/levframe",
    "description": "A lightweight framework using Laravel components",
    "keywords": [
        "framework",
        "lightweight",
        "queue",
        "job",
        "worker",
        "console",
        "cli",
        "command",
        "migration",
        "controller",
        "model",
        "view",
        "database",
        "orm",
        "php"
    ],
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.10",
        "illuminate/database": "^12.20",
        "illuminate/events": "^12.20",
        "illuminate/support": "^12.20",
        "vlucas/phpdotenv": "^5.6",
        "izniburak/router": "^3.0",
        "ext-json": "*",
        "league/plates": "^3.6",
        "ramsey/uuid": "^4.9",
        "robthree/twofactorauth": "^3.0",
        "symfony/console": "^7.2",
        "illuminate/filesystem": "^12.41",
        "symfony/var-dumper": "^8.0",
        "illuminate/queue": "^12.41",
        "illuminate/bus": "^12.41",
        "illuminate/cache": "^12.41",
        "illuminate/config": "^12.41",
        "illuminate/log": "^12.41",
        "illuminate/encryption": "^12.41"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/app/",
            "Core\\": "src/core/"
        },
        "files": [
            "src/core/Helpers.php"
        ]
    }
}
